# GridWise Environment Variable Configuration

# Server port. Next.js binds to 0.0.0.0 and respects this value.
PORT=3000

# LLM Provider Configuration ("nvidia", "openai", "gemini", or "auto")
# "auto" tries NVIDIA, then OpenAI, then Gemini, then the rule-based fallback.
LLM_PROVIDER=nvidia

# NVIDIA NIM API Settings (primary provider)
# NOTE: model availability is per-account. Verify with:
#   curl -H "Authorization: Bearer $NVIDIA_API_KEY" https://integrate.api.nvidia.com/v1/models
# meta/llama-3.1-8b-instruct reached end of life on 2026-08-26 and returns HTTP 410.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=mistralai/mistral-nemotron

# OpenAI API Settings (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Settings (optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
