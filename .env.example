# GridWise Environment Variable Configuration

# Server Port & Binding
PORT=3000

# LLM Provider Configuration ("openai", "gemini", "nvidia", or "auto")
LLM_PROVIDER=auto

# NVIDIA NIM API Settings (Recommended for competition - OpenAI-compatible)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# OpenAI API Settings (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Settings (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
